    <string name="onboarding_data_body">Enter the same credentials you use on the Oasis web interface to get started.</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">PoPS can notify you when new grades are published, when a grade is updated, or when a sync fails.\n\nTo receive notifications, the app needs your permission.</string>
