    <string name="onboarding_disclaimer_title">Welcome to PoPS</string>
    <string name="onboarding_disclaimer_body">PoPS is an unofficial app made by a student. It is not affiliated with Polytech Saclay or the university administration in any way.\n\nIt connects directly to the Oasis platform to fetch your grades, using the same credentials you use on the web interface.</string>
